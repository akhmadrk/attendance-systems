# ============================================================
# Employee WFH Attendance & HRD Monitoring System
# Environment Template (no real secrets — copy to `.env`)
# ============================================================

# ----- Primary Database (application data) -----
PRIMARY_DB_HOST=localhost
PRIMARY_DB_PORT=5432
PRIMARY_DB_USERNAME=attendance
PRIMARY_DB_PASSWORD=attendance
PRIMARY_DB_NAME=attendance

# ----- Audit Database (profile change logs) -----
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5433
AUDIT_DB_USERNAME=audit
AUDIT_DB_PASSWORD=audit
AUDIT_DB_NAME=audit

# ----- JWT -----
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ----- RabbitMQ -----
RABBITMQ_URL=amqp://localhost:5672

# ----- File Upload -----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=2097152

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- Service Ports -----
AUTH_SERVICE_PORT=3000
ATTENDANCE_SERVICE_PORT=3001
AUDIT_SERVICE_PORT=3002

# ----- Environment -----
NODE_ENV=development
